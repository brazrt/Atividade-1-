using System;

class Program
{
    static void Main()
    {
        Console.Write("Idade: ");
        int idade = int.Parse(Console.ReadLine());

        Console.Write("Altura (em metros): ");
        double altura = double.Parse(Console.ReadLine());

        bool podeEntrar = idade >= 12 && altura >= 1.40;

        Console.WriteLine(podeEntrar.ToString().ToLower());
    }
}
